{
  "$defs": {
    "EpicsCAOptions": {
      "additionalProperties": false,
      "description": "Channel-Access-specific options.\n\nCurrently empty: present so ``epicsca:`` survives in fastcs.yaml as the\ntransport discriminator key. Reserved for future CA-specific knobs.",
      "properties": {
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "object"
        }
      },
      "title": "EpicsCAOptions",
      "type": "object"
    },
    "EpicsCATransport": {
      "additionalProperties": false,
      "description": "Channel access transport.",
      "properties": {
        "epicsca": {
          "$ref": "#/$defs/EpicsCAOptions"
        },
        "docs": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpicsDocsOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gui": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpicsGUIOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EpicsCATransport",
      "type": "object"
    },
    "EpicsDocsOptions": {
      "description": "Docs options for EPICS.",
      "properties": {
        "output_dir": {
          "default": ".",
          "format": "path",
          "title": "Output Dir",
          "type": "string"
        },
        "title": {
          "default": "FastCS Devices",
          "title": "Title",
          "type": "string"
        },
        "depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth"
        }
      },
      "title": "EpicsDocsOptions",
      "type": "object"
    },
    "EpicsGUIFormat": {
      "description": "The format of an EPICS GUI.",
      "enum": [
        ".bob",
        ".edl"
      ],
      "title": "EpicsGUIFormat",
      "type": "string"
    },
    "EpicsGUIOptions": {
      "description": "Epics GUI options for use in both CA and PVA transports.",
      "properties": {
        "output_dir": {
          "default": ".",
          "format": "path",
          "title": "Output Dir",
          "type": "string"
        },
        "file_format": {
          "$ref": "#/$defs/EpicsGUIFormat",
          "default": ".bob"
        },
        "title": {
          "default": "FastCS Devices",
          "title": "Title",
          "type": "string"
        }
      },
      "title": "EpicsGUIOptions",
      "type": "object"
    },
    "EpicsPVAOptions": {
      "additionalProperties": false,
      "description": "PVAccess-specific options.\n\nCurrently empty: present so ``epicspva:`` survives in fastcs.yaml as the\ntransport discriminator key. Reserved for future PVA-specific knobs.",
      "properties": {},
      "title": "EpicsPVAOptions",
      "type": "object"
    },
    "EpicsPVATransport": {
      "additionalProperties": false,
      "description": "PV access transport.",
      "properties": {
        "epicspva": {
          "$ref": "#/$defs/EpicsPVAOptions"
        },
        "docs": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpicsDocsOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gui": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpicsGUIOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EpicsPVATransport",
      "type": "object"
    },
    "RestServerOptions": {
      "properties": {
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8080,
          "title": "Port",
          "type": "integer"
        },
        "log_level": {
          "default": "info",
          "title": "Log Level",
          "type": "string"
        }
      },
      "title": "RestServerOptions",
      "type": "object"
    },
    "RestTransport": {
      "additionalProperties": false,
      "description": "Rest Transport Adapter.",
      "properties": {
        "rest": {
          "$ref": "#/$defs/RestServerOptions"
        }
      },
      "title": "RestTransport",
      "type": "object"
    },
    "XimcConnectionConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fastcs_ximc.XimcConnection",
          "title": "Type",
          "type": "string"
        },
        "depends_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Depends On"
        },
        "settings": {
          "$ref": "#/$defs/XimcConnectionSettings"
        },
        "reconnect_period": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconnect Period"
        },
        "reconnect_attempts": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconnect Attempts"
        }
      },
      "required": [
        "type",
        "settings"
      ],
      "title": "XimcConnectionConfig",
      "type": "object"
    },
    "XimcConnectionSettings": {
      "description": "Where to find a single libximc device.\n\nA device is addressed by a full libximc URI. ``port``/``port_env`` are\nconvenience shorthands that expand to a ``xi-com://`` URI for the common\ncase of a directly attached serial controller.",
      "properties": {
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "port": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "port_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port Env"
        }
      },
      "title": "XimcConnectionSettings",
      "type": "object"
    },
    "XimcControllerEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "fastcs_ximc.XimcController",
          "title": "Type",
          "type": "string"
        },
        "connections": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "fastcs_ximc.XimcConnection": "#/$defs/XimcConnectionConfig",
                "fastcs_ximc.XimcDRAConnection": "#/$defs/XimcDRAConnectionConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/XimcConnectionConfig"
              },
              {
                "$ref": "#/$defs/XimcDRAConnectionConfig"
              }
            ]
          },
          "title": "Connections",
          "type": "object"
        },
        "poll_period": {
          "default": 0.2,
          "title": "Poll Period",
          "type": "number"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "XimcControllerEntry",
      "type": "object"
    },
    "XimcDRAConnectionConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fastcs_ximc.XimcDRAConnection",
          "title": "Type",
          "type": "string"
        },
        "depends_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Depends On"
        },
        "port_env": {
          "title": "Port Env",
          "type": "string"
        },
        "reconnect_period": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconnect Period"
        },
        "reconnect_attempts": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconnect Attempts"
        }
      },
      "required": [
        "type",
        "port_env"
      ],
      "title": "XimcDRAConnectionConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "controllers": {
      "items": {
        "$ref": "#/$defs/XimcControllerEntry"
      },
      "title": "Controllers",
      "type": "array"
    },
    "transport": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/EpicsCATransport"
          },
          {
            "$ref": "#/$defs/EpicsPVATransport"
          },
          {
            "$ref": "#/$defs/RestTransport"
          }
        ]
      },
      "title": "Transport",
      "type": "array"
    }
  },
  "required": [
    "controllers",
    "transport"
  ],
  "title": "XimcController",
  "type": "object"
}
